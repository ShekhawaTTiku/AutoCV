# Add your API keys here. The app reads .env on startup and on rerun.
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# Model settings (optional, defaults provided below)
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.5-flash-lite
MISTRAL_MODEL=mistral-large-latest

# Compiler (leave blank to auto-detect tools/tectonic or system compiler)
LATEX_COMPILER=
COMPILE_TIMEOUT_SECONDS=90
AI_TIMEOUT_SECONDS=60
SESSION_REQUEST_LIMIT=20
MAX_UPLOAD_MB=10

# Token budgets and limits
SESSION_TOKEN_LIMIT=120000
FULL_CONTEXT_TOKENS=12000
MAX_OUTPUT_TOKENS=4096
