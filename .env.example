# Add your API keys here. The app reads .env on startup and on rerun.
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# Model fallback order:
# 1. Google Gemini Primary: gemini-3.6-flash
# 2. Google Gemini Fallback: gemini-3.8-flash
# 3. Mistral Fallback: mistral-small-2603 (Mistral Small 4)
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
MISTRAL_MODEL=mistral-small-2603
GROQ_MODEL=openai/gpt-oss-120b

# Retries, deadlines, and timeouts
AI_DEADLINE_SECONDS=120
AI_TIMEOUT_SECONDS=60
MAX_RETRIES_PER_MODEL=2

# Compiler (leave blank to auto-detect tools/tectonic or system compiler)
LATEX_COMPILER=
COMPILE_TIMEOUT_SECONDS=90
SESSION_REQUEST_LIMIT=20
MAX_UPLOAD_MB=10

# Token budgets and limits
SESSION_TOKEN_LIMIT=120000
FULL_CONTEXT_TOKENS=12000
MAX_OUTPUT_TOKENS=4096
